{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.sandbox)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.development)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.sandbox)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.development)",
      "Read(./**/node_modules/**/*)",
      "Read(./**/dist/**/*)",
      "Read(./**/build/**/*)",
      "Read(./**/.next/**/*)",
      "Read(./**/.turbo/**/*)",
      "Read(./**/coverage/**/*)",
      "Read(./**/test-results/**/*)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/package-lock.json)",
      "Read(./**/go.sum)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "\"$HOME/.claude/devkit/hooks/bash-guard.sh\"", "timeout": 10}]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/plan_gate.py\"", "timeout": 10}]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/herdr_agent_gate.py\"", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "\"$HOME/.claude/devkit/hooks/format-edited-file.sh\"", "timeout": 30}]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "\"$HOME/.claude/devkit/hooks/comment-guard.sh\"", "timeout": 10}]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/skills/refresh-context/context_state.py\" check", "timeout": 20}]
      },
      {
        "matcher": "compact",
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/task_resume.py\"", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/verify_before_stop.py\"", "timeout": 260},
          {"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/task_log.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/obsidian_daily.py\" --hook", "timeout": 15}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/verify_before_stop.py\"", "timeout": 260},
          {"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/task_log.py\"", "timeout": 10}
        ]
      }
    ]
  }
}
