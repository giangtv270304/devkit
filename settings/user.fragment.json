{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.sandbox)",
      "Read(./**/node_modules/**/*)",
      "Read(./**/dist/**/*)",
      "Read(./**/build/**/*)",
      "Read(./**/.next/**/*)",
      "Read(./**/.turbo/**/*)",
      "Read(./**/coverage/**/*)",
      "Read(./**/test-results/**/*)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/package-lock.json)",
      "Read(./**/go.sum)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/plan_gate.py\"", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "\"$HOME/.claude/devkit/hooks/format-edited-file.sh\"", "timeout": 30}]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/skills/refresh-context/context_state.py\" check", "timeout": 20}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/task_log.py\"", "timeout": 10}]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{"type": "command", "command": "python3 \"$HOME/.claude/devkit/hooks/task_log.py\"", "timeout": 10}]
      }
    ]
  }
}
